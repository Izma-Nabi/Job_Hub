    {
      "name": "Register Company",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json && json.token) { pm.environment.set('companyToken', json.token); }",
              "if (json && json.id) { pm.environment.set('companyId', json.id); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"companyName\": \"Acme Ltd\",\n  \"email\": \"acme@example.com\",\n  \"password\": \"P@ssw0rd!\",\n  \"phoneNumber\": \"555-0100\",\n  \"industry\": \"Software\",\n  \"location\": \"Remote\",\n  \"website\": \"https://acme.example\",\n  \"description\": \"Acme company\"\n}" },
        "url": "http://localhost:3000/api/auth/register/company"
      }
    },
    {
      "name": "Login Company",
