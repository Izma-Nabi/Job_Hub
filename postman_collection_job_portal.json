    {
      "name": "Create Job (company)",
      "event": [
        {
          "listen": "prerequest",
          "script": { "exec": [ "// Ensure Authorization header is set from environment", "if (pm.environment.get('companyToken')) { pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + pm.environment.get('companyToken') }); }" ] }
        },
        {
          "listen": "test",
          "script": { "exec": [ "const json = pm.response.json();", "if (json && json.id) pm.environment.set('jobId', json.id);", "if (pm.response.code === 401) pm.test('Auth failed', () => { throw new Error('401 Unauthorized - token missing or invalid'); });" ] }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"Software Engineer\",\n  \"description\": \"Develop and maintain backend services.\",\n  \"requirements\": \"Node.js, SQL, REST\",\n  \"location\": \"Remote\",\n  \"salaryRange\": \"60k-90k\",\n  \"employmentType\": \"Full-time\",\n  \"deadline\": \"2026-01-31\",\n  \"isActive\": 1\n}" },
        "url": "http://localhost:3000/api/jobs"
      }
    },
    {
      "name": "Update Job (company owner or admin)",
      "event": [
        {
          "listen": "prerequest",
          "script": { "exec": [ "// Apply token from environment", "if (pm.environment.get('companyToken')) { pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + pm.environment.get('companyToken') }); }" ] }
        },
        {
          "listen": "test",
          "script": { "exec": [
            "// Fail on auth error",
            "if (pm.response.code === 401) pm.test('Auth failed', () => { throw new Error('401 Unauthorized - token missing or invalid'); });",
            "// Expect success status for update (200 or 204)",
            "pm.test('Update returned success status', () => { pm.expect([200,204]).to.include(pm.response.code); });",
            "// If server returns updated resource JSON, optionally update jobId",
            "try { const json = pm.response.json(); if (json && (json.id || json.JobID)) { pm.environment.set('jobId', json.id || json.JobID); } } catch (e) { /* no JSON body */ }",
            "// Basic check that response body (when present) reflects the fields we sent",
            "try { const json = pm.response.json(); if (json && json.title) pm.test('Title present in response', () => pm.expect(json.title).to.be.a('string')); } catch (e) { }"
          ] }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"Senior Software Engineer\",\n  \"salaryRange\": \"80k-110k\",\n  \"isActive\": 1\n}" },
        "url": "http://localhost:3000/api/jobs/{{jobId}}"
      }
    },
    {
      "name": "Delete Job (company owner or admin)",
      "event": [
        {
          "listen": "prerequest",
          "script": { "exec": [ "// Apply company token automatically", "if (pm.environment.get('companyToken')) { pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + pm.environment.get('companyToken') }); }" ] }
        },
        {
          "listen": "test",
          "script": { "exec": [
            "// Fail on auth error",
            "if (pm.response.code === 401) pm.test('Auth failed', () => { throw new Error('401 Unauthorized - token missing or invalid'); });",
            "// Expect deletion success: 200 (with JSON) or 204 No Content",
            "pm.test('Delete returned success status', () => { pm.expect([200,204]).to.include(pm.response.code); });",
            "// If deletion succeeded, remove jobId from environment to avoid accidental reuse",
            "if ([200,204].includes(pm.response.code)) { pm.environment.unset('jobId'); }",
            "// Optional: if JSON response includes a message, assert it's a success message",
            "try { const json = pm.response.json(); if (json && json.message) pm.test('Server returned message', () => pm.expect(json.message.toLowerCase()).to.match(/(deleted|removed|success)/)); } catch (e) { }"
          ] }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "http://localhost:3000/api/jobs/{{jobId}}"
      }
    },
